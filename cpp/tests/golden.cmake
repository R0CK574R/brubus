# Run `robotnav digest` on the three maps and compare it, line for line, with the digest kept in the repository
# (made on x86-64 Linux with GCC). Every result is printed as its exact 64 bits, so a pass means this build, on this
# compiler and this processor, computed precisely the same routes, searches and times.
#   cmake -DTOOL=<robotnav> -DMAPS=<dir of maps> -DGOLDEN=<golden.digest> -P golden.cmake
execute_process(COMMAND "${TOOL}" digest "${MAPS}/grassland.map" "${MAPS}/desert.map" "${MAPS}/island.map"
                OUTPUT_VARIABLE got RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "robotnav digest failed (${status}): ${err}")
endif()
file(READ "${GOLDEN}" want)
string(REPLACE "\r\n" "\n" got "${got}")
string(REPLACE "\r\n" "\n" want "${want}")
if(got STREQUAL want)
  string(REGEX MATCHALL "\n" lines "${got}")
  list(LENGTH lines n)
  message(STATUS "digest identical to the reference: ${n} lines")
  return()
endif()
string(REPLACE ";" "," got "${got}")
string(REPLACE ";" "," want "${want}")
string(REPLACE "\n" ";" got_lines "${got}")
string(REPLACE "\n" ";" want_lines "${want}")
list(LENGTH got_lines n_got)
list(LENGTH want_lines n_want)
set(shown 0)
set(k 0)
foreach(line IN LISTS want_lines)
  if(k LESS n_got)
    list(GET got_lines ${k} mine)
    if(NOT mine STREQUAL line AND shown LESS 5)
      message("line ${k}\n  reference: ${line}\n  this build: ${mine}")
      math(EXPR shown "${shown} + 1")
    endif()
  endif()
  math(EXPR k "${k} + 1")
endforeach()
message(FATAL_ERROR "the digest differs from the reference (${n_got} lines against ${n_want}): this build does not compute the same results")
